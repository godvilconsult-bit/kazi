# Copy to D:/KAZI/kazi/.env.production (git-ignored), fill in, then run `node deploy/railway-setup.mjs`.
# The script pipes secret values straight into Railway and never prints them.

# ── Your domain ──────────────────────────────────────────────────────────────
# DOMAIN is the bare domain. The site is served at https://SITE_HOST (default: DOMAIN) and the
# API at https://api.DOMAIN; the sign-in cookie is shared across .DOMAIN.
DOMAIN=
SITE_HOST=

# ── Admin ────────────────────────────────────────────────────────────────────
# Wallet(s) that may sign in as admin (comma-separated). Use a Safe owner's hardware wallet.
ADMIN_WALLETS=

# ── Claude ───────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── File storage (Supabase) ──────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_BUCKET=kazi-files-prod

# ── Platform signers in AWS KMS (secp256k1, ECC_SECG_P256K1, SIGN_VERIFY) ────
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
OPERATOR_KMS_KEY_ID=
QUOTER_KMS_KEY_ID=

# ── Optional ─────────────────────────────────────────────────────────────────
SENTRY_DSN=
ALERT_WEBHOOK_URL=
CHAINALYSIS_API_KEY=
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# ── Guarded launch limits (USDC) ─────────────────────────────────────────────
MAX_TASK_USDC=100
MAX_OPEN_ESCROW_USDC=2000

# JWT_SECRET, ENCRYPTION_KEY, HOUSE_AGENTS_SECRET and METRICS_TOKEN are generated by the
# setup script and appended here on first run. Keep them; changing them logs everyone out or
# breaks stored webhook secrets (see docs/runbooks/key-compromise.md to rotate).

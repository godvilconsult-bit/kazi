# ─── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development                 # development | test | production
KAZI_NETWORK=local                   # local | testnet | mainnet

# ─── Data stores (docker-compose defaults for local dev) ─────────────────────
DATABASE_URL=postgresql://kazi:kazi@localhost:5432/kazi
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=kazi                # namespaces keys/queues per environment

# ─── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=                          # >= 32 random chars
ENCRYPTION_KEY=                      # 32 bytes base64, for webhook secrets at rest
ADMIN_WALLETS=                       # comma-separated 0x addresses

# ─── LLM (docs/06-ROUTER.md §8) ───────────────────────────────────────────────
ANTHROPIC_API_KEY=
LLM_MODEL_ROUTER=claude-opus-5-5     # task decomposition
LLM_MODEL_JUDGE=claude-opus-5-5      # evaluator judge
LLM_MODEL_FAST=claude-haiku-5-5      # summaries / extraction
LLM_MODEL_AGENT=claude-opus-5-5      # house agents

# ─── Pricing (06-ROUTER §3) ──────────────────────────────────────────────────
TAKE_RATE_BPS=1200                   # escrow fee on every milestone; must be <= TaskEscrow.feeBps
SERVICE_FEE_BPS=500                  # router service fee, its own milestone paid to the treasury
MIN_SERVICE_FEE=0.10                 # USDC
TREASURY_ADDRESS=                    # payout of the kazi-service-fee provider (Safe in production)

# ─── Chain (values per network live in packages/config; see docs/00-ARC-FACTS.md)
ARC_RPC_URL=                         # optional override of the preset RPC (e.g. an Alchemy URL with key)
ARC_CHAIN_ID=31337                   # must match the preset for KAZI_NETWORK (local=31337, testnet=5042002, mainnet=5042)
CONFIRMATIONS=2
USDC_ADDRESS=                        # required for local (MockUSDC); optional override on testnet/mainnet

# ─── Platform signers (dev only; KMS in prod — never commit real keys) ───────
OPERATOR_PRIVATE_KEY=
QUOTER_PRIVATE_KEY=

# ─── File storage: Supabase Storage signed-URL API (server-side only) ────────
STORAGE_BUCKET=kazi-files

SUPABASE_PROJECT_REF=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=           # server-side only; never ship to the browser

# ─── API / worker tuning (defaults shown) ─────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=4000
QUOTE_DAILY_LIMIT=30                 # free quotes per wallet per day (each new one costs a router call)
# RPC given to browsers by GET /config (defaults to the network's public RPC; never the keyed ARC_RPC_URL)
PUBLIC_RPC_URL=
COOKIE_DOMAIN=                       # e.g. .kazi.app so app.* and api.* share the session; empty locally
INDEXER_POLL_MS=2000
INDEXER_BATCH_BLOCKS=2000
INDEXER_REORG_DEPTH=20
RECONCILE_EVERY_MS=300000
HOUSE_AGENTS_BASE_URL=http://localhost:4100   # used by the seed for house agent endpoints
HOUSE_AGENTS_PORT=4100
HOUSE_AGENTS_SECRET=                 # >= 32 random chars; house agents' webhook secrets derive from it
EXECUTOR_TICK_MS=5000
EXECUTOR_MAX_ATTEMPTS=3              # attempt 3 goes to a fallback provider when one exists
EXECUTOR_ATTEMPT_TIMEOUT_SEC=900
EXECUTOR_SYNC_RESPONSE_MS=75000
# Local dev only: let third-party agents (e.g. the SDK example on localhost) receive tasks. Never in production.
EXECUTOR_ALLOW_PRIVATE_ENDPOINTS=false
REVIEW_WINDOW_HOURS=72               # after delivery; then milestones release automatically
EVAL_PASS_THRESHOLD=70
EVAL_DOUBLE_JUDGE_ABOVE=50           # USDC; bigger milestones are judged twice
PAYOUTS_TICK_MS=15000
HOSTED_POLL_MS=60000                # how often finished Economy (batch) runs of hosted agents are collected

# ─── URLs / monitoring ───────────────────────────────────────────────────────
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
SENTRY_DSN=

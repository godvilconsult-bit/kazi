# ─── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development                 # development | test | production
KAZI_NETWORK=local                   # local | testnet | mainnet

# ─── Data stores (docker-compose defaults for local dev) ─────────────────────
DATABASE_URL=postgresql://kazi:kazi@localhost:5432/kazi   # add ?connection_limit=20 to size each process's pool (default 10)
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=kazi                # namespaces keys/queues per environment

# ─── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=                          # >= 32 random chars
ENCRYPTION_KEY=                      # 32 bytes base64, for webhook secrets at rest
ADMIN_WALLETS=                       # comma-separated 0x addresses

# ─── LLM (docs/06-ROUTER.md §8) ───────────────────────────────────────────────
ANTHROPIC_API_KEY=
LLM_MODEL_ROUTER=claude-opus-5-5     # task decomposition
LLM_MODEL_JUDGE=claude-opus-5-5      # evaluator judge
LLM_MODEL_FAST=claude-haiku-5-5      # summaries / extraction
LLM_MODEL_AGENT=claude-opus-5-5      # house agents

# ─── Pricing (06-ROUTER §3) ──────────────────────────────────────────────────
TAKE_RATE_BPS=1200                   # escrow fee on every milestone; must be <= TaskEscrow.feeBps
SERVICE_FEE_BPS=500                  # router service fee, its own milestone paid to the treasury
MIN_SERVICE_FEE=0.10                 # USDC
TREASURY_ADDRESS=                    # payout of the kazi-service-fee provider (Safe in production)

# ─── Chain (values per network live in packages/config; see docs/00-ARC-FACTS.md)
ARC_RPC_URL=                         # optional override of the preset RPC (e.g. an Alchemy URL with key)
ARC_CHAIN_ID=31337                   # must match the preset for KAZI_NETWORK (local=31337, testnet=5042002, mainnet=5042)
CONFIRMATIONS=2
USDC_ADDRESS=                        # required for local (MockUSDC); optional override on testnet/mainnet

# ─── Platform signers (docs/runbooks/deploy.md §4) ──────────────────────────
SIGNER_BACKEND=env                   # env (dev/testnet keys below) | aws-kms (production; required on mainnet)
OPERATOR_PRIVATE_KEY=                # dev/testnet only — never commit real keys
QUOTER_PRIVATE_KEY=
OPERATOR_KMS_KEY_ID=                 # aws-kms: secp256k1 key ids/ARNs (AWS_REGION + credentials from the AWS chain)
QUOTER_KMS_KEY_ID=
ALLOW_PLAINTEXT_KEYS=false           # production + env keys refused unless true (testnet only; never mainnet)

# ─── File storage: Supabase Storage signed-URL API (server-side only) ────────
STORAGE_BUCKET=kazi-files

SUPABASE_PROJECT_REF=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=           # server-side only; never ship to the browser

# ─── API / worker tuning (defaults shown) ─────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=4000
QUOTE_DAILY_LIMIT=30                 # free quotes per wallet per day (each new one costs a router call)
# Requests per minute per API key (public API, docs/12-PUBLIC-API.md)
API_KEY_RATE_LIMIT=120
# RPC given to browsers by GET /config (defaults to the network's public RPC; never the keyed ARC_RPC_URL)
PUBLIC_RPC_URL=
COOKIE_DOMAIN=                       # e.g. .kazi.app so app.* and api.* share the session; empty locally
TRUST_PROXY=false                    # hops of YOUR proxies that set X-Forwarded-For (e.g. 1 behind Railway/Cloudflare); never "true"
INDEXER_POLL_MS=2000
INDEXER_BATCH_BLOCKS=2000
INDEXER_REORG_DEPTH=20
RECONCILE_EVERY_MS=300000
HOUSE_AGENTS_BASE_URL=http://localhost:4100   # used by the seed for house agent endpoints
HOUSE_AGENTS_PORT=4100
HOUSE_AGENTS_SECRET=                 # >= 32 random chars; house agents' webhook secrets derive from it
ROUTER_CONCURRENCY=4                 # quotes planned in parallel per worker process
EXECUTOR_TICK_MS=5000
EXECUTOR_MAX_ATTEMPTS=3              # attempt 3 goes to a fallback provider when one exists
EXECUTOR_ATTEMPT_TIMEOUT_SEC=900
EXECUTOR_SYNC_RESPONSE_MS=75000
# Local dev only: let third-party agents (e.g. the SDK example on localhost) receive tasks. Never in production.
EXECUTOR_ALLOW_PRIVATE_ENDPOINTS=false
REVIEW_WINDOW_HOURS=72               # after delivery; then milestones release automatically
EVAL_PASS_THRESHOLD=70
EVAL_DOUBLE_JUDGE_ABOVE=50           # USDC; bigger milestones are judged twice
PAYOUTS_TICK_MS=15000
HOSTED_POLL_MS=60000                # how often finished Economy (batch) runs of hosted agents are collected

# ─── URLs / monitoring (docs/runbooks/deploy.md §5) ───────────────────────────
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
SENTRY_DSN=                          # API + worker error reporting
METRICS_TOKEN=                       # >= 16 chars: bearer token for GET /metrics (API) and the worker metrics port
WORKER_METRICS_PORT=                 # e.g. 9464; unset = no worker metrics server
ALERT_WEBHOOK_URL=                   # Slack/Discord-compatible incoming webhook for alerts
MONITOR_EVERY_MS=60000
ALERT_LARGE_RELEASE_USDC=500         # one release at or above this → LARGE_RELEASE
ALERT_DAILY_RELEASE_USDC=10000       # 24 h releases above this → DAILY_RELEASE_VOLUME
ALERT_QUEUE_BACKLOG=200              # waiting jobs in one queue → QUEUE_BACKLOG
ALERT_OPERATOR_MIN_GAS=1             # operator gas (native USDC) below this → OPERATOR_GAS_LOW
ALERT_LLM_HOURLY_USD=25              # LLM spend in one hour above this → LLM_COST_SPIKE

# ─── Guarded launch & incident switches (docs/09 §2, docs/runbooks/) ─────────
ROUTER_DISABLED=false                # true: refuse new quotes (API + worker); funded work continues
MAX_TASK_USDC=                       # e.g. 1000 for the first month on mainnet; empty = no cap
MAX_OPEN_ESCROW_USDC=                # e.g. 25000: total USDC in open escrow; empty = no cap
PROVIDER_ALLOWLIST=                  # comma-separated provider slugs quotable besides house agents; empty = all

# ─── Web app (apps/web) ─────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000
API_URL_INTERNAL=                    # optional: the API's address from the web server (private network)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID= # optional: enables WalletConnect
NEXT_PUBLIC_FEATURE_BOND=1           # 0 hides the provider $KAZI bond step (pre-launch notice instead)

# ─── Token launch (Phase 6, docs/08-TOKENOMICS.md §7) ───────────────────────
AIRDROP_ID=                          # which published airdrop allocation set /airdrop serves (API)
# Geo hooks (web server): visitors from these countries can't stake or claim airdropped tokens;
# exits (unstake, withdraw, USDC rewards) always stay open. The list is a legal decision — this is
# only a starting point: US + comprehensively sanctioned jurisdictions.
GEO_RESTRICTED_COUNTRIES=US,CU,IR,KP,SY
GEO_COUNTRY_HEADER=cf-ipcountry      # the header your CDN sets (Vercel: x-vercel-ip-country, CloudFront: cloudfront-viewer-country)

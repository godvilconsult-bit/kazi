{
  "name": "@kazi/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@openzeppelin/contracts": "5.6.1"
  },
  "scripts": {
    "build": "forge build",
    "test": "forge test -vvv",
    "test:coverage": "forge coverage --report summary --no-match-coverage \"(test|script|mocks)\"",
    "snapshot": "forge snapshot",
    "lint": "forge lint src",
    "fmt": "forge fmt",
    "deploy:local": "node scripts/deploy-local.mjs",
    "dev": "anvil --state .anvil/state.json",
    "deploy:testnet": "tsx scripts/deploy-testnet.ts",
    "deploy:mainnet": "tsx scripts/deploy-mainnet.ts",
    "token-launch:local": "node scripts/token-launch-local.mjs",
    "credits-gate:local": "node scripts/credits-gate-local.mjs"
  },
  "devDependencies": {
    "@kazi/config": "workspace:*",
    "@kazi/shared": "workspace:*",
    "tsx": "4.23.15",
    "viem": "^2.57.4"
  }
}

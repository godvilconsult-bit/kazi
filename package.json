{
  "name": "kazi",
  "private": true,
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "pnpm --filter @kazi/db run db:migrate",
    "db:seed": "pnpm --filter @kazi/db run db:seed",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "postinstall": "pnpm --filter @kazi/db generate",
    "db:test:prepare": "pnpm --filter @kazi/db db:test:prepare"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.9",
    "turbo": "^2.11.7",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3",
    "eslint-plugin-react-hooks": "7.1.1"
  }
}
